# ============================================================
# VARIABLES D'ENVIRONNEMENT — PRODUCTION (O2Switch)
# Copier ce fichier en .env sur le serveur et remplir les valeurs
# NE PAS committer .env dans git
# ============================================================

# Serveur
PORT=3001
NODE_ENV=production

# Base de données MySQL (cPanel → MySQL Databases)
# Le vrai nom sera préfixé par ton identifiant cPanel, ex: cpanelusername_ames_prod
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpanelusername_ames_prod
DB_USER=cpanelusername_ames_user
DB_PASSWORD=mot_de_passe_bdd_ici

# Frontend URL (pour CORS — doit correspondre exactement)
FRONTEND_URL=https://erosion-des-ames.com

# JWT — générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=remplacer_par_une_cle_aleatoire_de_64_bytes_minimum
JWT_EXPIRES_IN=24h

# Email SMTP (O2Switch — configurer dans cPanel → Email Accounts)
SMTP_HOST=mail.erosion-des-ames.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@erosion-des-ames.com
SMTP_PASS=mot_de_passe_email_ici
EMAIL_FROM="Érosion des Âmes" <noreply@erosion-des-ames.com>
